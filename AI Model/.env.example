# Copy this file to .env and fill in your values

# Required: Google Gemini API key for OCR text extraction
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Path to Poppler binary (for PDF-to-image conversion)
# Windows default: ./poppler/Library/bin
# Linux/Mac: leave blank (uses system poppler via apt/brew)
POPPLER_PATH=./poppler/Library/bin

# Set to 'production' to enforce strict model loading (no mock predictions)
# Set to 'development' (default) to allow mock fallback when model is missing
APP_ENV=development
